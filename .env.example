# Copy to .env and fill in. Never commit .env.

# Which ticket adapter to use: "mock" (no credentials, sample data) or "agile-studios"
TRIAGE_ADAPTER=mock

# --- Agile Studios (internal PM tool) — only needed when TRIAGE_ADAPTER=agile-studios ---
# Base URL of the Agile Studios API, e.g. https://agile-studios.internal.example.com/api/v1
AGILE_STUDIOS_BASE_URL=
# API token for Agile Studios. Create one in Agile Studios → Settings → API tokens.
AGILE_STUDIOS_API_TOKEN=
# Comma-separated project keys to include, e.g. MSG,COB
TRIAGE_PROJECT_KEYS=

# --- Pipeline tuning ---
# IANA timezone used for the cron schedule and report timestamps
TRIAGE_TIMEZONE=America/New_York
# How far back to look for changed tickets (days)
TRIAGE_LOOKBACK_DAYS=7
# Minimum classifier confidence (0-1) before a ticket is flagged "needs human review"
TRIAGE_MIN_CONFIDENCE=0.5
# Jaccard similarity (0-1) at or above which two tickets are flagged as likely duplicates
TRIAGE_DUPLICATE_THRESHOLD=0.35

# --- Optional notifiers (console is the default) ---
# SLACK_WEBHOOK_URL=
# REPORT_EMAIL_TO=
